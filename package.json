{
  "name": "atlas-of-thought",
  "productName": "Atlas of Thought",
  "version": "0.1.2",
  "description": "Turn your AI conversations into a Google-Maps-style atlas. Local-first desktop app.",
  "author": {
    "name": "ijichi-art",
    "email": "noreply@github.com",
    "url": "https://github.com/ijichi-art"
  },
  "homepage": "https://github.com/ijichi-art/atlas-of-thought",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "cross-env HOSTNAME=127.0.0.1 next dev -H 127.0.0.1 -p 3002",
    "build": "next build",
    "start": "cross-env HOSTNAME=127.0.0.1 next start -H 127.0.0.1",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "concurrently --kill-others --names next,electron --prefix-colors blue,green \"cross-env HOSTNAME=127.0.0.1 next dev -H 127.0.0.1 -p 3002\" \"wait-on http://127.0.0.1:3002 && electron .\"",
    "electron:build": "next build && electron-builder",
    "electron:build:mac": "next build && electron-builder --mac",
    "electron:build:win": "next build && electron-builder --win",
    "electron:build:linux": "next build && electron-builder --linux"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-sqlite3": "^12.9.0",
    "d3": "^7.9.0",
    "d3-force": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.43.0",
    "next": "16.2.12",
    "openai": "^6.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "^15.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3": "^7.4.3",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}
