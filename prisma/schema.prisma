// Atlas of Thought — Prisma schema
// Phase 0: auth + BYOK key storage.
// Domain models (Map/Country/City/...) declared here from day 1 to lock in
// the data model — N:N City<->Conversation in particular avoids a Phase 4
// breaking change when we introduce topic-segment splitting.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  // Solo-mode default: SQLite stored at the path in DATABASE_URL
  // (e.g. file:./atlas.db for dev, or an OS-app-data path for the
  // packaged Electron build). Postgres support remains in earlier
  // commits if a multi-tenant deployment is needed; the local-first
  // story is now the canonical path.
  provider = "sqlite"
}

// ============================================================================
// Auth.js (NextAuth v5) tables
// ============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  apiKeys     ApiKey[]
  maps        Map[]
  preference  UserPreference?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================================
// BYOK — encrypted Anthropic API keys
// ============================================================================

model ApiKey {
  id          String   @id @default(cuid())
  userId      String
  provider    String   @default("anthropic")
  // AES-256-GCM ciphertext encoded as: base64(iv) "." base64(ciphertext) "." base64(authTag)
  ciphertext  String 
  // Last 4 chars of the plaintext key, for display ("sk-...abcd")
  hint        String
  label       String?
  // User's chosen model for this provider. Empty string = use the provider default.
  model       String   @default("")
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

// Stores the user's active chat provider selection.
model UserPreference {
  userId       String @id
  chatProvider String @default("anthropic")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================================
// Atlas domain — declared early to avoid breaking changes later
// ============================================================================

enum Visibility {
  private
  unlisted
  public
}

enum CityRank {
  capital
  city
  town
}

// Place is a recursive geographic node: Region > Country > District > City > Block.
// The leaf (usually City, sometimes Block) holds POIs (individual conversations).
// Depth is determined by terraform from the conversation count — small maps may
// only use Country, large ones go all the way to Block.
enum PlaceLevel {
  region
  country
  district
  city
  block
}

enum RoadType {
  highway
  regular
  trail
  ferry
}

enum TerrainType {
  mountain
  forest
  river
  sea_border
}

enum SourceType {
  chatgpt
  claude
  claude_code
  cursor
  gemini
  manual
  native
}

enum ArtifactKind {
  code
  document
  image
  diagram
}

enum LandmarkType {
  library
  museum
  monument
  workshop
}

model Map {
  id         String     @id @default(cuid())
  userId     String
  title      String     @default("My Atlas")
  visibility Visibility @default(private)
  shareSlug  String?    @unique
  // Natural-language directive ("skip anything about X") applied by the
  // cartographer LLM during terraform. Persisted so re-terraform can
  // pre-fill it for editing. Layer 2 of the privacy pipeline.
  exclusionDirective String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  places        Place[]
  roads         Road[]
  terrain       TerrainFeature[]
  conversations Conversation[]
}

// Hierarchical geographic node. Each map has a forest of Places rooted at
// level=country (or level=region for huge maps). Children belong to their
// parent's polygon. Conversations are attached as POIs to the LEAF Place
// they belong to (typically a city, sometimes a block).
model Place {
  id        String     @id @default(cuid())
  mapId     String
  parentId  String?
  level     PlaceLevel
  name      String
  nameJa    String?
  theme     String?
  // Hex color (countries are themed, lower levels inherit / override).
  color     String     @default("#c9b88a")
  // For drawn boundaries (region/country/district/city). Block doesn't
  // need a polygon — it's rendered as a chunk of the parent city's grid.
  polygon   Json?
  // Anchor point used for force layout, label, and built-up centroid.
  positionX Float
  positionY Float
  // Per-level rank (0 = capital/primary). For city level, drives built-up
  // radius and label prominence.
  rank      Int        @default(0)
  // Stable creation order within siblings (terraform fills this so the same
  // input produces the same map without depending on cuid order).
  ordinal   Int        @default(0)
  // City-only: built-up polygon radius in user-units (drives POI scatter
  // and the in-city street grid).
  builtUpR  Float?
  // City-only: legacy CityRank for label/pin styling continuity.
  cityRank  CityRank?
  // City-only: short narrative summary surfaced in the side panel.
  summary   String?  
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  map           Map                 @relation(fields: [mapId], references: [id], onDelete: Cascade)
  parent        Place?              @relation("PlaceHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children      Place[]             @relation("PlaceHierarchy")
  conversations PlaceConversation[]
  artifacts     Artifact[]
  roadsFrom     Road[]              @relation("RoadFrom")
  roadsTo       Road[]              @relation("RoadTo")

  @@index([mapId, level])
  @@index([parentId])
}

model Conversation {
  id              String      @id @default(cuid())
  mapId           String
  source          SourceType
  externalId      String?     // upstream id (chatgpt conv id etc.) for dedupe
  title           String?
  topicEmbedding  Bytes?      // pgvector via raw SQL until pgvector-prisma in Phase 4
  createdAtSource DateTime?
  importedAt      DateTime    @default(now())
  // POI position inside the leaf Place's built-up polygon (absolute map
  // coords). Set by terraform when the conversation is attached. Null until
  // the conversation has been placed.
  poiX            Float?
  poiY            Float?
  // Categorical POI kind, set by the cartographer LLM. One of:
  // code | research | personal | question | creative | decision.
  // Drives the pin color so each cluster city looks like a real Google
  // Maps neighborhood (mix of red/purple/blue pins) instead of a swarm
  // of identical dots. Null until terraform classifies it.
  poiKind         String?

  map      Map                 @relation(fields: [mapId], references: [id], onDelete: Cascade)
  messages Message[]
  places   PlaceConversation[]

  @@unique([mapId, source, externalId])
}

// N:N Place <-> Conversation. A conversation is normally attached to one
// leaf Place, but the table supports topic-segment splitting (segmentStart/
// segmentEnd) for the future Phase 4 feature.
model PlaceConversation {
  placeId        String
  conversationId String
  segmentStart   Int      @default(0)
  segmentEnd     Int      @default(-1)
  createdAt      DateTime @default(now())

  place        Place        @relation(fields: [placeId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([placeId, conversationId, segmentStart, segmentEnd])
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  // 0-based ordinal within the conversation
  ordinal         Int
  role            String   // user | assistant | system | tool
  text            String 
  // Phase 4: topic-segment id for in-conversation splitting. Null in Phase 2.
  topicSegmentId  String?
  createdAt       DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, ordinal])
  @@index([topicSegmentId])
}

model Road {
  id        String   @id @default(cuid())
  mapId     String
  fromId    String
  toId      String
  type      RoadType @default(regular)
  label     String?
  rationale String?
  // Conceptual link strength from the LLM (0..1). Drives bundling weight
  // and may inform render width in future iterations.
  weight    Float    @default(1)
  // Optional intermediate waypoints (cluster centroids, etc.) so multiple
  // roads sharing a trunk segment render bit-identically.
  waypoints Json?
  createdAt DateTime @default(now())

  map  Map   @relation(fields: [mapId], references: [id], onDelete: Cascade)
  from Place @relation("RoadFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Place @relation("RoadTo",   fields: [toId],   references: [id], onDelete: Cascade)

  @@index([mapId])
}

model TerrainFeature {
  id              String      @id @default(cuid())
  mapId           String
  type            TerrainType
  // GeoJSON-like geometry: { kind: "polygon"|"polyline", coords: [[x,y],...] }
  geometry        Json
  betweenCountryA String?
  betweenCountryB String?
  createdAt       DateTime    @default(now())

  map Map @relation(fields: [mapId], references: [id], onDelete: Cascade)
}

model Artifact {
  id            String       @id @default(cuid())
  // The Place this artifact belongs to (typically a city-level Place).
  placeId       String
  kind          ArtifactKind
  landmarkType  LandmarkType
  title         String
  content       String     
  createdAt     DateTime     @default(now())

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
}
