{
  "name": "atlas-of-thought",
  "productName": "Atlas of Thought",
  "version": "0.1.0",
  "description": "Turn your AI conversations into a Google-Maps-style atlas. Local-first desktop app.",
  "author": {
    "name": "ijichi-art",
    "email": "noreply@github.com",
    "url": "https://github.com/ijichi-art"
  },
  "homepage": "https://github.com/ijichi-art/atlas-of-thought",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002 -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "concurrently --kill-others --names next,electron --prefix-colors blue,green \"next dev -p 3002 -H 127.0.0.1\" \"wait-on http://127.0.0.1:3002 && electron .\"",
    "electron:build": "next build && electron-builder",
    "electron:build:mac": "next build && electron-builder --mac",
    "electron:build:win": "next build && electron-builder --win",
    "electron:build:linux": "next build && electron-builder --linux"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-sqlite3": "^12.9.0",
    "d3": "^7.9.0",
    "d3-force": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.38.0",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "openai": "^6.34.0",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "^15.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "overrides": {
    "postcss": ">=8.5.10",
    "@hono/node-server": ">=1.19.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3": "^7.4.3",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "^41.4.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5",
    "wait-on": "^9.0.5"
  }
}
