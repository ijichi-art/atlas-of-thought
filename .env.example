# ============================================================================
# Atlas of Thought — environment variables (Solo / local-first build)
# Copy to .env.local for development. NEVER commit .env / .env.local.
# ============================================================================

# --- Database (SQLite, local-first) ---
# Solo mode stores everything in a single SQLite file. The Electron build
# resolves this to an OS app-data directory at startup; for `npm run dev`
# the default below puts the DB inside ./prisma so it's gitignored.
DATABASE_URL="file:./prisma/dev.db"

# --- BYOK encryption ---
# Master key used to encrypt user-supplied LLM API keys (AES-256-GCM).
# Generate with: openssl rand -base64 32
# IMPORTANT: rotating this key invalidates all stored API keys.
ENCRYPTION_KEY=""

# --- Public origin (used for share URLs / OGP if you publish a snapshot) ---
NEXT_PUBLIC_ORIGIN="http://localhost:3000"
